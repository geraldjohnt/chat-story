{
  "name": "chat-drama-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && npm run build && playwright test",
    "build": "vite build && tsx scripts/copy-story-data.ts && tsx scripts/verify-dist.ts",
    "build:e2e": "vite build --outDir dist-e2e --base /chat-story/ && node -e \"require('node:fs').rmSync('dist-e2e/access-gate.json', { force: true })\" && tsx scripts/copy-story-data.ts --root tests/fixtures/stories --out dist-e2e --fixtures && tsx scripts/verify-dist.ts --dir dist-e2e --fixtures",
    "preview": "vite preview",
    "validate:stories": "tsx scripts/validate-stories.ts && tsx scripts/validate-stories.ts --root tests/fixtures/stories --fixtures",
    "check:parts": "tsx scripts/check-part-changes.ts",
    "story:next-id": "tsx scripts/next-story-id.ts",
    "setup:password": "tsx scripts/setup-password.ts",
    "verify:dist": "tsx scripts/verify-dist.ts",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run validate:stories && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "hash-wasm": "^4.12.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
