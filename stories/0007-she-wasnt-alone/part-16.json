        {
          "kind": "message",
          "id": "m01",
          "sender": "tess",
          "text": "Cst. Morrison, the person with June's phone is Noah Comeau, 16, Paul Comeau's son. He found it in a lockbox in his father's truck on Jan 31. His father has noticed it's missing. Noah is taking the 5 PM bus to his mother's in Bridgewater."
        },
        {
          "kind": "message",
          "id": "m02",
          "sender": "leah",
          "text": "Thank you. This is the right call. I'm bringing in our Bridgewater detachment now."
        },
        {
          "kind": "message",
          "id": "m03",
          "sender": "leah",
          "text": "Please don't ask him to bring the phone anywhere. We'll arrange it with his mother present. He's a minor."
        },
        {
          "kind": "message",
          "id": "m04",
          "sender": "tess",
          "text": "Understood."
        },
        {
          "kind": "message",
          "id": "m05",
          "sender": "leah",
          "text": "And Ms. Pellerin, don't reply to Mr. Comeau tonight. About anything."
        }
