        },
        {
          "kind": "message",
          "id": "m04",
          "sender": "ruth",
          "text": "Your father gave me three weeks' notice after twenty-two years. It turns out I'm still not good at finding things out by accident."
        },
        {
          "kind": "message",
          "id": "m05",
          "sender": "sam",
          "text": "this isnt that though"
        },
        {
          "kind": "message",
