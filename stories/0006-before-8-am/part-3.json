      "messages": [
        {
          "kind": "timestamp",
          "id": "t01",
          "label": "Sun, 18 Apr at 5:49 PM"
        },
        {
          "kind": "message",
          "id": "m01",
          "sender": "ruth",
          "text": "Out by 30 May. Transfer."
        },
        {
          "kind": "message",
          "id": "m02",
          "sender": "ruth",
          "text": "Out of where, Iain?"
        },
        {
          "kind": "message",
          "id": "m03",
          "sender": "iain",
          "text": "Out of 3B. I'm moving to Dunedin. I put in for a transfer to the comms centre there in January."
        },
        {
          "kind": "message",
          "id": "m04",
          "sender": "iain",
          "text": "Fiona's having twins in June. Her husband's away on the boats half the year. I'm the only family she's got down there."
        },
        {
          "kind": "message",
          "id": "m05",
          "sender": "iain",
          "text": "It came through last week. I've been trying to find a way to say it."
        },
        {
          "kind": "message",
          "id": "m06",
          "sender": "ruth",
          "text": "You've had a week of ways, Iain. Oriental Bay. The concert. A dozen dinners. You've known since January."
        },
        {
          "kind": "message",
          "id": "m07",
          "sender": "iain",
          "text": "I know."
        },
        {
          "kind": "message",
          "id": "m08",
          "sender": "iain",
          "text": "When I applied I didn't know you. I wasn't expecting to meet anyone. I'm 52. I'd sort of decided that part was done."
        },
        {
          "kind": "message",
          "id": "m09",
          "sender": "ruth",
          "text": "So had I."
        },
        {
          "kind": "message",
          "id": "m10",
          "sender": "iain",
          "text": "I'm not making an excuse. I should have told you the day it came through."
        },
        {
          "kind": "message",
          "id": "m11",
          "sender": "ruth",
          "text": "Yes. You should have."
        },
        {
          "kind": "message",
          "id": "m12",
          "sender": "ruth",
          "text": "I need tonight. Go to work."
        },
        {
          "kind": "message",
          "id": "m13",
          "sender": "iain",
          "text": "Aye. I'll go."
        }
      ],
      "meta": {
        "beat": "The explanation."
      }
    },
