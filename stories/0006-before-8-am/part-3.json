      "messages": [
        {
          "kind": "timestamp",
          "id": "t01",
          "label": "Mon, 19 Apr at 7:05 AM"
        },
        {
          "kind": "message",
          "id": "m01",
          "sender": "ruth",
          "text": "You're home?"
        },
        {
          "kind": "message",
          "id": "m02",
          "sender": "iain",
          "text": "Just in. Sitting on the stairs. Didn't want to slam anything."
        },
        {
          "kind": "message",
          "id": "m03",
          "sender": "ruth",
          "text": "I'm going to say this plainly and you're going to let me finish."
        },
        {
          "kind": "message",
          "id": "m04",
          "sender": "ruth",
          "text": "I'm not doing long distance. I'm 48 and I've done enough waiting by a phone. I won't make you promises about Dunedin and I won't ask for any."
        },
        {
          "kind": "message",
          "id": "m05",
          "sender": "iain",
          "text": "That's fair."
        },
        {
          "kind": "message",
          "id": "m06",
          "sender": "ruth",
          "text": "I wasn't finished."
        },
        {
          "kind": "message",
          "id": "m07",
          "sender": "iain",
          "text": "Sorry. Go on."
        },
        {
          "kind": "message",
          "id": "m08",
          "sender": "ruth",
          "text": "You have six weeks left. I'd like them. Eyes open, no wee lies, and you tell me the day anything changes."
        },
        {
          "kind": "message",
          "id": "m09",
          "sender": "iain",
          "text": "Every day. I'll tell you every day."
        },
        {
          "kind": "message",
          "id": "m10",
          "sender": "iain",
          "text": "Can I come up? I'll bring two coffees."
        },
        {
          "kind": "message",
          "id": "m11",
          "sender": "ruth",
          "text": "The door's unlocked. Close it like a baby.",
          "receipt": {
            "status": "read",
            "at": "7:09 AM"
          }
        }
      ],
      "meta": {
        "beat": "Six weeks, eyes open."
      }
