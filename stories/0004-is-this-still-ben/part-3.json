          "kind": "message",
          "id": "m18",
          "sender": "ben",
          "text": "she told you we drifted, right"
        },
        {
          "kind": "message",
          "id": "m19",
          "sender": "marisol",
          "text": "she told me you hadn't talked since 2020"
        },
        {
          "kind": "message",
          "id": "m20",
          "sender": "ben",
          "text": "we didn't drift. she picked."
        },
        {
          "kind": "message",
          "id": "m21",
          "sender": "ben",
          "text": "i'll think about mom. don't text this number unless i text first."
